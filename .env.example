AUTHORIZED_USERS=[{"name":"Ahmed","pin":"1234"},{"name":"Amera","pin":"2345"},{"name":"Dr.Tarek","pin":"3456"},{"name":"Fatema","pin":"4567"},{"name":"Hamadto","pin":"5678"},{"name":"Hanady","pin":"6789"},{"name":"Henady","pin":"7890"},{"name":"Lama","pin":"8901"},{"name":"Malik","pin":"9012"},{"name":"Mo.Saloumi","pin":"0123"},{"name":"Rahma","pin":"1357"},{"name":"Shimaa","pin":"2468"},{"name":"Yara","pin":"3579"}]

# Google Sheets (service account)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
